// typechecks each face's phone code against the framework's runtime, which it imports from paf/
{
  "extends": "../paf/tsconfig.json",
  "include": ["../*/src/pkjs/**/*.ts", "../core/pkjs/**/*.ts", "../paf/ts/**/*.d.ts"],
  "exclude": [
    "../node_modules",
    "../targets",
    "../*/src/pkjs/clay/builder/**",
    "../core/pkjs/clay/builder/**",
    "../core/pkjs/testing/**",
    "../**/*.spec.ts"
  ]
}
