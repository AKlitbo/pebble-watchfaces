{
  "name": "pebble-watchfaces-sketchbook",
  "author": "Null Syntax",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "workspaces": [
    "paf",
    "paf/plugins/*"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "scripts": {
    "test": "vitest run --config config/vitest.config.ts --passWithNoTests",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage --passWithNoTests",
    "lint": "eslint . --config config/eslint.config.ts",
    "lint:fix": "eslint . --fix --config config/eslint.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
