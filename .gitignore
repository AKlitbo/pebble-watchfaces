# Pebble / Waf build output
build/
.lock-waf_*

# Waf-compiled resource artifacts (sources are versioned)
*.reso

# each face or family under watchfaces/ ignores its own lib/, node_modules/, and targets/

# Python
__pycache__/
*.pyc

# Node
node_modules/
npm-debug.log*

# compiled PKJS output (regenerated by build:pkjs from TS source)
/emit/

# editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# generated documentation, coverage, and site builds
doxygen
coverage/
site/

# temporary files & local secrets
.tmp
.env
.env.local

# Third-party vendored assets (fonts, icons, templates) - not redistributed.
vendor/

# the local Clay settings preview, rebuilt by tools/dev/clay-preview.ts on demand
clay-preview.html
